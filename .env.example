# Copy this file to ".env" and fill in real values. NEVER commit ".env".

DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# mysql (default) or sqlite (quick local checks / CI only)
DB_ENGINE=mysql
DB_NAME=routelync_db
DB_USER=routelync_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# ---------------------------------------------------------------- Email (see docs/EMAIL_SETUP.md)
# DEVELOPMENT: the console backend only PRINTS emails in the terminal that runs the server. Nothing reaches an inbox.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# REAL DELIVERY: use the SMTP backend and fill in the provider's details, for example for Gmail:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=your-account@gmail.com
#   EMAIL_HOST_PASSWORD=<a Google "app password", not your normal password>
#   DEFAULT_FROM_EMAIL=RouteLync <verified-sender@your-domain.com>
#   DEFAULT_REPLY_TO_EMAIL=no-reply@your-domain.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=RouteLync <no-reply@routelync.local>
DEFAULT_REPLY_TO_EMAIL=no-reply@routelync.local

# ---------------------------------------------------------------- Location search (see docs/LOCATION_SETUP.md)
# photon (default; meant for search-as-you-type) or nominatim. The PUBLIC servers are fair-use only: for real traffic run your
# own server or a commercial Photon/Nominatim-compatible service and put its address and key here.
GEOCODER_PROVIDER=photon
GEOCODER_BASE_URL=
GEOCODER_API_KEY=
GEOCODER_CONTACT_EMAIL=
GEOCODER_USER_AGENT=RouteLync/1.0 (municipal complaint routing)
GEOCODER_TIMEOUT=5
# Initial map viewport only: min_lat,min_lon,max_lat,max_lon. Coverage is checked against Bengaluru Urban/Rural districts.
LOCATION_MAP_BOUNDS=12.65,77.18,13.50,77.95
# Basemap tiles. Default is Esri World Street Map; use a provider you are licensed to use for production traffic.
LOCATION_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}
LOCATION_TILE_ATTRIBUTION=Tiles &copy; Esri - Sources: Esri, HERE, Garmin, OpenStreetMap contributors, and the GIS User Community
LOCATION_TILE_CSP_SOURCE=https://server.arcgisonline.com

# Staff logins made by `manage.py setup_staff_accounts` look like electricityofficer1@<this domain>
STAFF_EMAIL_DOMAIN=company.com

# Upload limit for complaint images (MB)
MAX_IMAGE_SIZE_MB=5

# ---------------------------------------------------------------- Notifications by email and WhatsApp (see docs/NOTIFICATIONS.md)
# Every in-app notification (complaint submitted, routed, worker assigned, resolved, ...) is also sent here.
SITE_URL=http://127.0.0.1:8000            # for phone testing, replace with this PC's Wi-Fi IPv4 address
# For public use, set SITE_URL to your HTTPS domain, for example https://complaints.yourcity.gov.in
NOTIFY_EMAIL_ENABLED=True                  # needs the SMTP settings above to reach a real inbox
NOTIFY_WHATSAPP_ENABLED=False              # True only after you fill in ONE provider below
NOTIFY_EXTERNAL_ROLES=CITIZEN,OFFICER,FIELD_WORKER,ADMIN
WHATSAPP_PROVIDER=twilio                   # twilio or meta
WHATSAPP_COUNTRY_CODE=91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886          # Twilio's sandbox number, or your approved sender
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_NAME=                    # Meta: an approved template with one body variable {{1}}
WHATSAPP_TEMPLATE_LANG=en
